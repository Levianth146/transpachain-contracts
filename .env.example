# ── Avalanche Fuji C-Chain (primary target for Team1 Vietnam UniHack) ──
# Public RPC, no API key needed. Faucet: https://team1vn.xyz/faucet.html
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# Circle USDC on Fuji (check on https://testnet.snowtrace.io before deploy; script also checks it has code)
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Demo helpers (optional): shorten governance so a full milestone vote fits in a live demo
VOTING_PERIOD_SECONDS=300
TIMELOCK_SECONDS=120
# Org wallet to auto-verify after deploy (optional)
DEMO_ORG_ADDRESS=0xYOUR_DEMO_ORG_ADDRESS

# ── V2 Safe 3/5 (Module A) — fill before create-safe / deploy-v2 ──
# Five MetaMask EOAs controlled by the team for the hackathon demo (document in README).
SAFE_OWNERS=0xOWNER1,0xOWNER2,0xOWNER3,0xOWNER4,0xOWNER5
SAFE_THRESHOLD=3
# Optional: fix salt for a deterministic predicted Safe address
# SAFE_SALT_NONCE=1
# Set PREDICT_ONLY=1 on create-safe.ts to print the address without broadcasting
# PREDICT_ONLY=1
# Filled by: npx hardhat run hardhat/scripts/create-safe.ts --network fuji
DISBURSEMENT_SAFE=0xYOUR_SAFE_ADDRESS_AFTER_CREATE_SAFE

# ── V2 Yield mock (Module C) ──
# Declared sink for MockERC4626Vault.simulateLoss (e.g. burn / dead address). Required for deploy-v2.
LOSS_SINK=0x000000000000000000000000000000000000dEaD
# Optional: owner of MockERC4626Vault (simulateYield / simulateLoss). Defaults to deployer.
# YIELD_CONTROLLER=0xYOUR_YIELD_CONTROLLER

# Deploy V2 (Hardhat, Windows-primary):
#   npx hardhat run hardhat/scripts/create-safe.ts --network fuji
#   # copy DISBURSEMENT_SAFE=... into this .env
#   npx hardhat run hardhat/scripts/deploy-v2.ts --network fuji
# Optional Foundry (WSL): forge script script/DeployV2.s.sol --rpc-url fuji --broadcast ...
# SKIP_VERIFY=1 to skip Routescan verification during deploy-v2

# Filled after deploy (used by hardhat/scripts/demo.ts and setTierMetadata.ts)
CHARITY_CORE_ADDRESS=
DONATION_VAULT_ADDRESS=
GOVERNANCE_DAO_ADDRESS=
IMPACT_NFT_ADDRESS=
DISBURSEMENT_CONTROLLER_ADDRESS=
YIELD_MANAGER_ADDRESS=
MOCK_ERC4626_VAULT_ADDRESS=
PINATA_API_KEY=YOUR_PINATA_KEY
PINATA_SECRET_KEY=YOUR_PINATA_SECRET

# ── Legacy: Ethereum Sepolia (v3 deployment, kept for reference) ──
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=
